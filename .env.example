# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in what you need.
# Nothing here is required for the offline sample mode.
# ---------------------------------------------------------------------------

# Groq (free tier) for AI tender summaries. Without it, rule-based summaries are used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Reasoning models such as openai/gpt-oss-20b need room for hidden reasoning tokens.
GROQ_MAX_TOKENS=800
# Only sent for gpt-oss models; low/medium/high.
GROQ_REASONING_EFFORT=low

# Google Sheets export.
# GOOGLE_SERVICE_ACCOUNT_JSON can be a path to the service-account JSON file
# or the JSON itself (useful for GitHub Secrets).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# GeM fetching behaviour.
GEM_TIMEOUT=30
GEM_MAX_PAGES=5
# Try a headless browser if GeM blocks plain requests (needs requirements-optional).
ALLOW_PLAYWRIGHT_FALLBACK=false
# Show realistic sample tenders if the live fetch fails. Set false to fail loudly.
GEM_SAMPLE_FALLBACK=true
# Force sample mode regardless of the UI toggle.
GEM_SAMPLE_MODE=false

# Backend / frontend wiring.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000
BRAIN_API_URL=http://127.0.0.1:8000
BRAIN_UI_PORT=8501

# Optional: move stored settings/runs somewhere else.
# GEM_DATA_DIR=C:\projects\gem_automation\data
